;; Beethoven: Ode to Joy (public-domain melody), synthetic orchestral study.
;; 16 sections x 4 independently panned desks = 64 sounds, 256 voices (the
;; default compiler limits). Final tutti really plays all 256 voices together.
;; This is a stress arrangement, not a sampled orchestra or the original score.
;; ./out/lgs render --input examples/ode-to-joy-orchestra.lg \
;;   --output out/ode-to-joy-orchestra.wav --duration 34s --tail 2s
(tempo 120)

;; name, waveform, cutoff, attack, release, octave, gain, pan centre.
(def sections
  [[:violin-i :saw 96 28 36 12 3 22]
   [:violin-ii :saw 88 32 38 0 3 38]
   [:viola :saw 78 34 40 0 3 54]
   [:cello :saw 68 36 42 -12 4 82]
   [:double-bass :trisaw 60 32 36 -24 5 100]
   [:flute :sine 112 18 26 12 4 36]
   [:piccolo :sine 116 12 20 24 2 44]
   [:oboe :pulse 82 22 28 0 2 52]
   [:clarinet :pulse 65 24 30 0 3 72]
   [:bassoon :pulse 58 28 32 -12 3 86]
   [:horn :saw 66 32 36 -12 3 30]
   [:trumpet :saw 100 18 26 0 2 64]
   [:trombone :saw 76 24 32 -12 3 92]
   [:tuba :trisaw 54 30 34 -24 4 104]
   [:harp :trisaw 106 1 24 12 3 16]
   [:celesta :sine 120 0 30 24 3 112]])

(defn desk-id [section desk]
  (keyword (str (name (nth section 0)) "-" desk)))

(defn desk-sound [section desk]
  (instrument (desk-id section desk) {:voices 4}
    (oscillator {:type (nth section 1) :color 72 :gain 96
                 :detune (+ 62 desk)})
    (filter {:type :lowpass :frequency (nth section 2) :resonance 32})
    (envelope {:attack (nth section 3) :decay 64
               :sustain (if (> (nth section 3) 1) 96 12)
               :release (nth section 4)})
    (mulp)
    (pan {:panning (+ (nth section 7) (* desk 3))})
    (out {:gain (quot (nth section 6) 2)})))

(install-patch! (apply patch (for [section sections desk (range 4)]
                              (desk-sound section desk))))

;; Two 16-beat phrases; the dotted ending is expressed as beat/duration pairs.
(def melody
  [[0 64 1] [1 64 1] [2 65 1] [3 67 1]
   [4 67 1] [5 65 1] [6 64 1] [7 62 1]
   [8 60 1] [9 60 1] [10 62 1] [11 64 1]
   [12 64 3/2] [27/2 62 1/2] [14 62 2]
   [16 64 1] [17 64 1] [18 65 1] [19 67 1]
   [20 67 1] [21 65 1] [22 64 1] [23 62 1]
   [24 60 1] [25 60 1] [26 62 1] [27 64 1]
   [28 62 3/2] [59/2 60 1/2] [30 60 2]])
(def harmony [[48 55 60] [43 55 59] [48 55 60] [43 55 59]
              [48 55 60] [43 55 59] [48 53 57] [48 55 60]])

;; First statement: strings, then winds, then brass. Second: full ensemble.
;; Each desk has one melody line and three sustained harmonic notes.
(doseq [round (range 2) section-index (range 16) desk (range 4)]
  (let [section (nth sections section-index)
        id (desk-id section desk)
        octave (nth section 5)
        entrance (if (= round 1) 0
                   (if (< section-index 5) 0
                     (if (< section-index 10) 8 16)))]
    (doseq [event melody]
      (if (>= (nth event 0) entrance)
        (play id (+ (nth event 1) octave)
              {:at (+ (* round 32) (nth event 0)) :dur (* (nth event 2) 9/10)})))
    (doseq [bar (range 8)]
      (if (>= (* bar 4) entrance)
        (doseq [pitch (nth harmony bar)]
          (play id (+ pitch octave)
                {:at (+ (* round 32) (* bar 4)) :dur 39/10}))))))

;; A held tonic at beat 64: no reservations-only claim; every slot sounds.
(doseq [section sections desk (range 4) pitch [48 55 60 64]]
  (play (desk-id section desk) (+ pitch (nth section 5)) {:at 64 :dur 4}))
